{
  "name": "dsh-device-center",
  "description": "DeepSeek Harness device center: one tool that fronts the Personal Infrastructure Control Plane — your devices, VMs, WSL, containers, services, endpoints and capabilities, addressed by stable IDs instead of IPs and passwords.",
  "version": "0.3.1",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/tree-logic.test.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "infra",
    "infrastructure",
    "control-plane",
    "device-center"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7 || 0.1.1-rc.2 || 0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2 || 0.1.7-alpha.1 || 0.1.7-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
